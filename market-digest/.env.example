# Claude API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gmail：需开启两步验证后生成“应用专用密码” https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=
NEWSLETTER_TO=you@gmail.com

# 可选：X 官方 API（付费）。留空则使用邮件通知方式
X_BEARER_TOKEN=

# Discord Bot token: https://discord.com/developers/applications → Bot → Reset Token
# 需要在 Bot 设置里打开 MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=

# Dashboard 登录密码（部署到公网服务器时一定要设置）
DASHBOARD_USER=me
DASHBOARD_PASSWORD=
