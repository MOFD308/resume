# ================================================================
#  Market Digest 密钥文件
#  格式：每行「名称=值」，等号两边不要有空格，值不用加引号。
#  以 # 开头的行是说明，程序会忽略。
#  这个文件只在你电脑上，不会上传到 GitHub。不要发给任何人。
# ================================================================

# ---------- 必填 ----------

# Claude API key（console.anthropic.com → API Keys），以 sk-ant- 开头
ANTHROPIC_API_KEY=

# 用来发简报的 Gmail 地址
GMAIL_ADDRESS=
# Gmail 应用专用密码：16 位，不是 Gmail 登录密码（myaccount.google.com/apppasswords）
GMAIL_APP_PASSWORD=
# 接收简报的邮箱，可以和上面的 Gmail 是同一个
NEWSLETTER_TO=

# ---------- 建议填 ----------

# X API Bearer Token（console.x.com → 你的 App → Keys and tokens）
# 留空则改为读取 X 的通知邮件（可能漏推文）
X_BEARER_TOKEN=

# 打开点位看板时要输入的用户名和密码，自己随便设
DASHBOARD_USER=me
DASHBOARD_PASSWORD=

# ---------- 现在不用填，以后需要时再说 ----------

# 安卓手机转发 Discord 通知时用的口令（用 Windows 电脑读 Discord 通知则不需要）
INGEST_TOKEN=
# 手动转发到自己 Discord 服务器时用的 Bot token
DISCORD_BOT_TOKEN=
# 部署到云服务器时 YouTube 需要的代理（家里电脑不需要）
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
YOUTUBE_PROXY=
